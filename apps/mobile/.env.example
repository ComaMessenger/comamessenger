# Store builds (fastlane). Copy to apps/mobile/.env; keys stay outside git.

# App Store Connect API key (Users and Access → Integrations), role App Manager or Admin.
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_PRIVATE_KEY_PATH=/absolute/path/AuthKey_XXXXXXXXXX.p8
APPLE_TEAM_ID=

# Google Play service account with access to the app in Play Console.
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=/absolute/path/play-service-account.json
GOOGLE_PLAY_TRACK=internal

# Push relay this build is signed for (ADR-0012); empty disables push registration.
COMA_PUSH_RELAY_URL=
