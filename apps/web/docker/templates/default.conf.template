# Rendered at container start by the nginx entrypoint (envsubst of COMA_*).
map $host $coma_csp {
    default "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https: wss: ${COMA_CSP_CONNECT}; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'";
}

server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    access_log off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /web-healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /config.js {
        default_type application/javascript;
        include /etc/nginx/coma-security-headers.conf;
        add_header Cache-Control "no-store" always;
        return 200 'window.__COMA_CONFIG__ = { apiURL: "${COMA_API_URL}" };\n';
    }

    # Hashed bundles never change under the same name.
    location /assets/ {
        include /etc/nginx/coma-security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location = /sw.js {
        include /etc/nginx/coma-security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # Client-side routes fall back to the application shell.
    location / {
        include /etc/nginx/coma-security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
