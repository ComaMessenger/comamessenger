APP_ENV=development
HTTP_ADDR=:8080
PUBLIC_API_URL=http://localhost:8080
DATABASE_URL=postgres://comamessenger:comamessenger@postgres:5432/comamessenger?sslmode=disable

POSTGRES_DB=comamessenger
POSTGRES_USER=comamessenger
POSTGRES_PASSWORD=comamessenger

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=comamessenger
S3_ACCESS_KEY=comamessenger
S3_SECRET_KEY=comamessenger-local-secret
S3_PREFIX=
S3_FORCE_PATH_STYLE=true

MINIO_ROOT_USER=comamessenger
MINIO_ROOT_PASSWORD=comamessenger-local-secret
