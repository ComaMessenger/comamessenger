APP_ENV=development
HTTP_ADDR=:8080
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8080
BIND_ADDRESS=127.0.0.1
WEB_PORT=5173
WEB_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://comamessenger:comamessenger@postgres:5432/comamessenger?sslmode=disable
AUTH_SIGNING_KEY=comamessenger-local-signing-key-change-me
# Keep this key stable when rotating JWT signing keys; stored S3/SMTP secrets depend on it.
INTEGRATION_ENCRYPTION_KEY=comamessenger-local-integration-key-change-me
BOOTSTRAP_TOKEN=
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
INVITATION_TTL=168h
AUTH_COOKIE_SECURE=false
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2

MESSAGE_MAX_BODY_BYTES=65536
MESSAGE_MAX_PAGE_SIZE=100
WS_AUTH_TIMEOUT=5s
WS_MAX_FRAME_BYTES=262144
WS_MAX_CONNECTIONS_PER_ACTOR=10
WS_MAX_PENDING_CONNECTIONS=256
WS_MAX_CONCURRENT_WRITES=8
WS_MAX_QUEUED_EVENTS=256
WS_MAX_QUEUED_BYTES=1048576
WS_MAX_UNACKED_EVENTS=128
WS_HEARTBEAT_INTERVAL=25s
WS_PONG_TIMEOUT=10s
WS_ACK_INTERVAL=1s
WS_ACK_TIMEOUT=30s
WS_ACK_BATCH_SIZE=50
WS_TYPING_TTL=6s
WS_PRESENCE_TTL=60s
WS_ACTIVE_SUBSCRIPTION_TTL=60s
WS_EPHEMERAL_RATE_LIMIT=30
WS_EPHEMERAL_RATE_WINDOW=10s
EVENT_POLL_INTERVAL=200ms
EVENT_WAKE_COALESCE=5ms
EVENT_RETENTION=72h
EVENT_RETENTION_MIN_COUNT=100000
EVENT_RETENTION_INTERVAL=5m
EVENT_RETENTION_BATCH_SIZE=10000

REDIS_MODE=required
REDIS_PASSWORD=comamessenger-local-redis-secret
REDIS_URL=redis://:comamessenger-local-redis-secret@redis:6379/0
REDIS_EPHEMERAL_SIGNING_KEY=comamessenger-local-ephemeral-signing-key
REDIS_NAMESPACE=coma:v1
REDIS_CONNECT_TIMEOUT=1s
REDIS_OPERATION_TIMEOUT=500ms
REDIS_MAXMEMORY=128mb

# Generate with: docker compose --env-file .env -f deploy/compose.yaml run --rm --no-deps core vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost
PUSH_POLL_INTERVAL=1s

POSTGRES_DB=comamessenger
POSTGRES_USER=comamessenger
POSTGRES_PASSWORD=comamessenger

STORAGE_DRIVER=local
LOCAL_STORAGE_QUOTA_BYTES=2147483648
LOCAL_STORAGE_MIN_FREE_BYTES=268435456
FILE_MAX_BYTES=104857600
FILE_MULTIPART_THRESHOLD_BYTES=16777216
FILE_UPLOAD_TTL=24h
FILE_PRESIGN_TTL=15m

S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=
S3_FORCE_PATH_STYLE=false

# Optional bundled MinIO: set STORAGE_DRIVER=s3, uncomment the values below,
# and start Compose with --profile s3.
# S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_BUCKET=comamessenger
# S3_ACCESS_KEY=comamessenger
# S3_SECRET_KEY=comamessenger-local-secret
# S3_FORCE_PATH_STYLE=true

MINIO_ROOT_USER=comamessenger
MINIO_ROOT_PASSWORD=comamessenger-local-secret

# Optional agent runtime (`docker compose --profile agents ...`). Create an
# agent API key in Settings and grant only the scopes needed by that agent.
AGENT_RUNTIME_API_KEY=
AGENT_RUNTIME_CONSUMER=builtin-runtime
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
