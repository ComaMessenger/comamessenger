# nginx on the host instead of the bundled Caddy (docs/install.md, «Свой nginx»).
#
# 1. In .env: COMPOSE_FILE=compose.yaml:compose.host-proxy.yaml and remove
#    "caddy" from COMPOSE_PROFILES (keep "agents"/"s3" if used). Core then
#    listens on 127.0.0.1:8080 and Web on 127.0.0.1:8081 (CORE_HOST_PORT,
#    WEB_HOST_PORT), docker compose up -d --wait.
# 2. Replace chat.example.com below, put the file into /etc/nginx/sites-available/coma.conf,
#    link it into sites-enabled, get a certificate:
#      certbot --nginx -d chat.example.com
# 3. nginx -t && systemctl reload nginx

upstream coma_core {
    server 127.0.0.1:8080;
    keepalive 16;
}

upstream coma_web {
    server 127.0.0.1:8081;
    keepalive 16;
}

# Bundled S3 (profile "s3") only: compose.host-proxy.yaml publishes it on
# 127.0.0.1:9100; uncomment this and the bucket location below.
# upstream coma_s3 {
#     server 127.0.0.1:9100;
# }

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name chat.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Invitation links carry bearer tokens: keep them out of the access log.
    location ~ ^/api/v1/invitations/ {
        access_log off;
        return 301 https://$host$request_uri;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name chat.example.com;

    ssl_certificate /etc/letsencrypt/live/chat.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chat.example.com/privkey.pem;

    # Keep a little above FILE_MAX_BYTES from .env (100 MiB by default).
    client_max_body_size 110m;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location ~ ^/api/v1/invitations/ {
        access_log off;
        proxy_pass http://coma_core;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # API and WebSocket (/api/v1/ws). Core sends a heartbeat every 25 s, so a
    # 75 s read timeout only closes dead connections.
    location /api/ {
        proxy_pass http://coma_core;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 75s;
        proxy_request_buffering off;
    }

    location = /healthz {
        proxy_pass http://coma_core;
    }

    location = /readyz {
        proxy_pass http://coma_core;
    }

    # location ^~ /comamessenger/ {
    #     add_header Content-Security-Policy "sandbox; default-src 'none'" always;
    #     add_header X-Content-Type-Options "nosniff" always;
    #     proxy_pass http://coma_s3;
    #     proxy_set_header Host $host;
    #     proxy_request_buffering off;
    # }

    location / {
        proxy_pass http://coma_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
