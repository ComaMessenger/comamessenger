# Coma settings. Create .env with ./generate-env.sh <domain>: it copies this
# file, fills the secrets and the addresses, and sets mode 0600.
# Keep .env with your backups: without INTEGRATION_ENCRYPTION_KEY stored
# integration secrets cannot be decrypted after a restore.

# --- Version and startup ------------------------------------------------------
# Release these installation files belong to; compose.yaml pins its images.
# Change it only with ./upgrade.sh.
COMA_VERSION=__COMA_VERSION__
# What docker compose starts: caddy (HTTPS), agents (AI agents), s3 (bundled S3).
COMPOSE_PROFILES=caddy
COMPOSE_PROJECT_NAME=coma

# --- Addresses ----------------------------------------------------------------
# Domain Caddy obtains a certificate for. For a trial without a domain:
# COMA_SITE_ADDRESS=http://localhost and PUBLIC_APP_URL=http://localhost
COMA_SITE_ADDRESS=chat.example.com
# Address people open in the browser and enter in the mobile app.
PUBLIC_APP_URL=https://chat.example.com
# Ports Caddy listens on.
HTTP_PORT=80
HTTPS_PORT=443
# Your own nginx instead of Caddy (nginx.conf.example): uncomment, and remove
# "caddy" from COMPOSE_PROFILES. Core and Web then listen on 127.0.0.1.
# COMPOSE_FILE=compose.yaml:compose.host-proxy.yaml
# CORE_HOST_PORT=8080
# WEB_HOST_PORT=8081
# The browser finds the API on PUBLIC_APP_URL. Set only if the API has its own domain.
# COMA_API_URL=

# --- Secrets (generate-env.sh fills them) ---------------------------------------
APP_ENV=production
AUTH_COOKIE_SECURE=true
POSTGRES_PASSWORD=
REDIS_PASSWORD=
AUTH_SIGNING_KEY=
# Encrypts stored S3/SMTP/AI-provider secrets. Never change it.
INTEGRATION_ENCRYPTION_KEY=
REDIS_EPHEMERAL_SIGNING_KEY=
# One-time code of the setup screen that creates the workspace owner.
BOOTSTRAP_TOKEN=
# Internal key of the bundled agent runtime (profile "agents"), not an AI provider key.
AGENT_RUNTIME_API_KEY=

# --- Mail and push ------------------------------------------------------------
# Invitations and password resets go through the Coma mail service
# (https://mail.coma-chat.com) without any setup; it needs an https:// address.
# "off" disables it; a workspace can use its own SMTP in Settings → Mail.
# MAIL_RELAY_URL=
# Mobile push goes through the Coma push relay the published apps are built for.
# "off" disables mobile push.
PUSH_RELAY_URL=https://push.coma-chat.com
# Web Push in browsers; generate-env.sh creates the key pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Files --------------------------------------------------------------------
# local: files on a Docker volume of this server (default).
# s3: an S3-compatible storage, bundled (profile "s3") or external.
STORAGE_DRIVER=local
# Total size of files on the local volume, bytes (default 20 GiB).
LOCAL_STORAGE_QUOTA_BYTES=21474836480
# Refuse uploads when the disk has less free space, bytes (default 1 GiB).
LOCAL_STORAGE_MIN_FREE_BYTES=1073741824
# Largest file, bytes (100 MiB). Keep FILE_UPLOAD_LIMIT a little above it.
FILE_MAX_BYTES=104857600
FILE_UPLOAD_LIMIT=110MB

# S3 settings, used only with STORAGE_DRIVER=s3.
#   Bundled (add "s3" to COMPOSE_PROFILES): S3_ENDPOINT=http://s3gw:9000,
#   S3_PUBLIC_ENDPOINT=<PUBLIC_APP_URL>, S3_BUCKET=comamessenger,
#   S3_FORCE_PATH_STYLE=true; generate-env.sh --s3 fills the key pair.
#   External (Yandex Object Storage, Selectel, VK Cloud, MinIO…): the provider's
#   endpoint for both S3_ENDPOINT and S3_PUBLIC_ENDPOINT, its region and keys.
#   The bucket must exist and allow CORS GET/PUT/HEAD from PUBLIC_APP_URL with
#   the ETag header exposed.
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false

# --- Agents (profile "agents") --------------------------------------------------
AGENT_RUNTIME_CONCURRENCY=4
# Agent Architect spending limits, USD per UTC day and month ("off" removes one).
ARCHITECT_DAILY_COST_LIMIT=5
ARCHITECT_MONTHLY_COST_LIMIT=50
# Internal systems agent integrations may reach (CIDR, IP, host:port), comma-separated.
INTEGRATIONS_ALLOWED_PRIVATE_TARGETS=
