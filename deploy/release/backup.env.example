# Backup settings for backup.sh and restore.sh. Copy to backup.env and fill in.
# Not passed to Coma's containers.

# Where archives go and how many of the newest stay.
BACKUP_DIR=./backups
BACKUP_KEEP=14

# Encrypt archives with a passphrase kept in a file (one line, 32+ characters).
# Without the file an encrypted backup cannot be restored: store a copy
# outside this server. Create one: openssl rand -hex 32 > /root/coma-backup.pass
# BACKUP_PASSPHRASE_FILE=/root/coma-backup.pass

# Upload every archive to S3-compatible storage (Yandex Object Storage,
# Selectel, VK Cloud, AWS…). The newest BACKUP_S3_KEEP archives stay there.
# BACKUP_S3_URL=s3://my-backups/coma
# BACKUP_S3_ENDPOINT=https://storage.yandexcloud.net
# BACKUP_S3_REGION=ru-central1
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_KEEP=30
