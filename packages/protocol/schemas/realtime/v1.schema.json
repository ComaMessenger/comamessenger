{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comamessenger.dev/schemas/realtime/v1.schema.json",
  "title": "Coma realtime protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/ClientFrame" },
    { "$ref": "#/$defs/ServerFrame" }
  ],
  "$defs": {
    "Sequence": {
      "type": "integer",
      "format": "int64",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "UUID": {
      "type": "string",
      "format": "uuid"
    },
    "NullableUUID": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "KnownDurableEventType": {
      "type": "string",
      "enum": [
        "message.created",
        "message.updated",
        "message.deleted",
        "message.pinned",
        "message.unpinned",
        "message.saved",
        "message.unsaved",
        "reaction.added",
        "reaction.removed",
        "thread.followed",
        "thread.unfollowed",
        "read.marked",
        "draft.updated",
        "draft.deleted",
        "chat.created",
        "chat.updated",
        "chat.archived",
        "member.joined",
        "member.updated",
        "member.removed",
        "actor.status.updated",
        "actor.avatar.updated",
        "scheduled_message.created",
        "scheduled_message.updated",
        "scheduled_message.deleted",
        "scheduled_message.sent",
        "scheduled_message.failed",
        "request.assigned",
        "request.updated",
        "request.tally.updated",
        "request.answer.updated",
        "request.reminded",
        "request.auto_reminded",
        "reminder.created",
        "reminder.updated",
        "reminder.deleted",
        "reminder.fired",
        "org.updated",
        "task.updated",
        "task.notified"
      ]
    },
    "CloseCode": {
      "type": "integer",
      "format": "int32",
      "enum": [1000, 1008, 1012, 4001, 4008, 4009],
      "x-enum-varnames": [
        "NormalClosure",
        "PolicyViolation",
        "ServiceRestart",
        "AuthenticationFailed",
        "SlowConsumer",
        "ResyncRequired"
      ]
    },
    "AuthFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "request_id", "access_token", "last_seq"],
      "properties": {
        "op": { "type": "string", "enum": ["auth"] },
        "request_id": { "$ref": "#/$defs/UUID" },
        "access_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "last_seq": { "$ref": "#/$defs/Sequence" }
      }
    },
    "AckFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "seq"],
      "properties": {
        "op": { "type": "string", "enum": ["ack"] },
        "seq": { "$ref": "#/$defs/Sequence" }
      }
    },
    "SubscribeActiveFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "chat_id", "thread_root_id"],
      "properties": {
        "op": { "type": "string", "enum": ["subscribe_active"] },
        "chat_id": { "$ref": "#/$defs/NullableUUID" },
        "thread_root_id": { "$ref": "#/$defs/NullableUUID" }
      }
    },
    "TypingFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "chat_id", "thread_root_id", "active"],
      "properties": {
        "op": { "type": "string", "enum": ["typing"] },
        "chat_id": { "$ref": "#/$defs/UUID" },
        "thread_root_id": { "$ref": "#/$defs/NullableUUID" },
        "active": { "type": "boolean" },
        "action": { "$ref": "#/$defs/TypingAction" }
      }
    },
    "SetPresenceFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "state"],
      "properties": {
        "op": { "type": "string", "enum": ["presence"] },
        "state": { "type": "string", "enum": ["active", "away"] }
      }
    },
    "AgentStatusFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "run_id", "lease_token", "chat_id", "thread_root_id", "state"],
      "properties": {
        "op": { "type": "string", "enum": ["agent.status"] },
        "run_id": { "$ref": "#/$defs/UUID" },
        "lease_token": { "$ref": "#/$defs/UUID" },
        "chat_id": { "$ref": "#/$defs/UUID" },
        "thread_root_id": { "$ref": "#/$defs/NullableUUID" },
        "state": { "type": "string", "enum": ["thinking", "tool", "streaming", "completed", "failed", "canceled"] }
      }
    },
    "MessageStreamingFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "run_id", "lease_token", "chat_id", "thread_root_id", "stream_id", "index", "delta", "reset", "done"],
      "properties": {
        "op": { "type": "string", "enum": ["message.streaming"] },
        "run_id": { "$ref": "#/$defs/UUID" },
        "lease_token": { "$ref": "#/$defs/UUID" },
        "chat_id": { "$ref": "#/$defs/UUID" },
        "thread_root_id": { "$ref": "#/$defs/NullableUUID" },
        "stream_id": { "$ref": "#/$defs/UUID" },
        "index": { "$ref": "#/$defs/Sequence" },
        "delta": { "type": "string", "maxLength": 8192 },
        "reset": { "type": "boolean" },
        "done": { "type": "boolean" }
      }
    },
    "ClientFrame": {
      "oneOf": [
        { "$ref": "#/$defs/AuthFrame" },
        { "$ref": "#/$defs/AckFrame" },
        { "$ref": "#/$defs/SubscribeActiveFrame" },
        { "$ref": "#/$defs/TypingFrame" },
        { "$ref": "#/$defs/SetPresenceFrame" },
        { "$ref": "#/$defs/AgentStatusFrame" },
        { "$ref": "#/$defs/MessageStreamingFrame" }
      ]
    },
    "HelloFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "request_id",
        "connection_id",
        "current_seq",
        "min_retained_seq",
        "heartbeat_interval_ms",
        "ack_interval_ms",
        "ack_batch_size",
        "max_unacked_events"
      ],
      "properties": {
        "op": { "type": "string", "enum": ["hello"] },
        "request_id": { "$ref": "#/$defs/UUID" },
        "connection_id": { "$ref": "#/$defs/UUID" },
        "current_seq": { "$ref": "#/$defs/Sequence" },
        "min_retained_seq": { "$ref": "#/$defs/Sequence" },
        "heartbeat_interval_ms": { "type": "integer", "minimum": 1000 },
        "ack_interval_ms": { "type": "integer", "minimum": 100 },
        "ack_batch_size": { "type": "integer", "minimum": 1 },
        "max_unacked_events": { "type": "integer", "minimum": 1 },
        "features": {
          "description": "Optional protocol additions this server accepts. typing_actions: the action field on typing frames. message_requests: requests («Запрос») — the request REST routes, Message.request and the request.* events. message_reminders: personal reminders («Напомнить мне») — the reminder REST routes and the reminder.* events. org_structure: departments and positions («Оргструктура») — the org REST routes, the org fields of ActorSummary, OrganizationMember and Message, mentioned_department_ids in message, request and scheduled message bodies, the department and position request audiences and the org.updated event. message_tasks: tasks («Задача») — the task REST routes, GET /api/v1/inbox/waiting, Message.task, the task fields of the unread snapshot and the task.updated and task.notified events. A client hides a feature the server does not list.",
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "maxLength": 64 }
        }
      }
    },
    "DurableEventFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "seq",
        "type",
        "occurred_at",
        "actor_id",
        "subject_id",
        "data"
      ],
      "properties": {
        "op": { "type": "string", "enum": ["event"] },
        "seq": { "$ref": "#/$defs/Sequence" },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "occurred_at": { "type": "string", "format": "date-time" },
        "actor_id": { "$ref": "#/$defs/UUID" },
        "chat_id": { "$ref": "#/$defs/NullableUUID" },
        "subject_id": { "$ref": "#/$defs/UUID" },
        "data": {
          "type": "object",
          "additionalProperties": true,
          "description": "Event payload. For message.created, message.updated and message.deleted it is the message in the shape of the REST feed (components/schemas/Message: files with metadata and no links, thread_reply_count, mentioned_actor_ids, blocks, agent_provenance and request when present; never request_viewer, which is per reader), read when the event is delivered, plus silent on message.created and thread_root_reply_count on thread replies. A frame that would exceed the frame limit (WS_MAX_FRAME_BYTES) is never sent as is: its data becomes a stub with truncated: true — for message.* the Message shape with an empty body, no files and no blocks, for other events only their short scalar fields — and the client loads the record by REST. The data of request.* and reminder.* events is described by the RequestAssignedEvent … ReminderFiredEvent definitions: it never carries message text, notes, comments or who answered what. The data of org.updated is OrgUpdatedEvent: only the new version and a reason, never names or people. Frames are encoded without HTML escaping."
        }
      }
    },
    "ResyncRequiredFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "current_seq", "min_retained_seq", "reason"],
      "properties": {
        "op": { "type": "string", "enum": ["resync_required"] },
        "current_seq": { "$ref": "#/$defs/Sequence" },
        "min_retained_seq": { "$ref": "#/$defs/Sequence" },
        "reason": { "type": "string", "enum": ["event_history_expired"] }
      }
    },
    "TypingEventFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "actor_id",
        "chat_id",
        "thread_root_id",
        "active",
        "expires_at"
      ],
      "properties": {
        "op": { "type": "string", "enum": ["typing"] },
        "actor_id": { "$ref": "#/$defs/UUID" },
        "chat_id": { "$ref": "#/$defs/UUID" },
        "thread_root_id": { "$ref": "#/$defs/NullableUUID" },
        "active": { "type": "boolean" },
        "action": { "$ref": "#/$defs/TypingAction" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "TypingAction": {
      "description": "What the person is doing in the chat; absent means typing (clients before the field).",
      "type": "string",
      "enum": ["typing", "recording_voice", "uploading_photo", "uploading_video", "uploading_file"]
    },
    "PresenceEventFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "actor_id", "state", "expires_at"],
      "properties": {
        "op": { "type": "string", "enum": ["presence"] },
        "actor_id": { "$ref": "#/$defs/UUID" },
        "state": { "type": "string", "enum": ["online", "away", "offline"] },
        "expires_at": { "type": "string", "format": "date-time" },
        "last_seen_at": {
          "description": "With away or offline: when the person left, sent only to those who share a chat with them when neither side hides last seen.",
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "PresenceSnapshotFrame": {
      "description": "Sent once after hello: everyone in the workspace who is online or away right now.",
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "actors"],
      "properties": {
        "op": { "type": "string", "enum": ["presence.snapshot"] },
        "actors": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actor_id", "state", "expires_at"],
            "properties": {
              "actor_id": { "$ref": "#/$defs/UUID" },
              "state": { "type": "string", "enum": ["online", "away"] },
              "expires_at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "AgentStatusEventFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "actor_id", "run_id", "chat_id", "thread_root_id", "state", "expires_at"],
      "properties": {
        "op": { "type": "string", "enum": ["agent.status"] },
        "actor_id": { "$ref": "#/$defs/UUID" },
        "run_id": { "$ref": "#/$defs/UUID" },
        "chat_id": { "$ref": "#/$defs/UUID" },
        "thread_root_id": { "$ref": "#/$defs/NullableUUID" },
        "state": { "type": "string", "enum": ["thinking", "tool", "streaming", "completed", "failed", "canceled"] },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "MessageStreamingEventFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "actor_id", "run_id", "chat_id", "thread_root_id", "stream_id", "index", "delta", "reset", "done", "expires_at"],
      "properties": {
        "op": { "type": "string", "enum": ["message.streaming"] },
        "actor_id": { "$ref": "#/$defs/UUID" },
        "run_id": { "$ref": "#/$defs/UUID" },
        "chat_id": { "$ref": "#/$defs/UUID" },
        "thread_root_id": { "$ref": "#/$defs/NullableUUID" },
        "stream_id": { "$ref": "#/$defs/UUID" },
        "index": { "$ref": "#/$defs/Sequence" },
        "delta": { "type": "string", "maxLength": 8192 },
        "reset": { "type": "boolean" },
        "done": { "type": "boolean" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "ProtocolErrorFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "code", "message"],
      "properties": {
        "op": { "type": "string", "enum": ["error"] },
        "request_id": { "$ref": "#/$defs/NullableUUID" },
        "code": {
          "type": "string",
          "enum": [
            "invalid_frame",
            "not_authenticated",
            "forbidden",
            "rate_limited",
            "service_unavailable"
          ]
        },
        "message": { "type": "string" }
      }
    },
    "RequestAssignedEvent": {
      "description": "data of request.assigned, sent only to one recipient of a new request (subject_id is the message id). Written in the same transaction before message.created so the client knows the request is addressed to it before it shows the card.",
      "type": "object",
      "additionalProperties": false,
      "required": ["message_id", "chat_id", "due_at"],
      "properties": {
        "message_id": { "$ref": "#/$defs/UUID" },
        "chat_id": { "$ref": "#/$defs/UUID" },
        "due_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "RequestUpdatedEvent": {
      "description": "data of request.updated, sent to the whole chat (subject_id is the message id): an answer that changes the count, closing, a recipient leaving. Only counters: never who answered or how.",
      "type": "object",
      "additionalProperties": false,
      "required": ["message_id", "chat_id", "status", "closed_reason", "answered_count", "waiting_count", "version"],
      "properties": {
        "message_id": { "$ref": "#/$defs/UUID" },
        "chat_id": { "$ref": "#/$defs/UUID" },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "closed_reason": { "type": ["string", "null"], "enum": ["author", "moderator", "message_deleted", "expired", null] },
        "answered_count": { "type": "integer", "minimum": 0 },
        "waiting_count": { "type": "integer", "minimum": 0 },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "RequestTallyUpdatedEvent": {
      "description": "data of request.tally.updated, sent only to the author of the request (subject_id is the message id) after any answer. Chat admins who are not the author reload listRequestAnswers on request.updated instead.",
      "type": "object",
      "additionalProperties": false,
      "required": ["message_id", "chat_id", "tally", "waiting_count", "version"],
      "properties": {
        "message_id": { "$ref": "#/$defs/UUID" },
        "chat_id": { "$ref": "#/$defs/UUID" },
        "tally": { "type": "array", "maxItems": 4, "items": { "type": "integer", "minimum": 0 } },
        "waiting_count": { "type": "integer", "minimum": 0 },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "RequestAnswerUpdatedEvent": {
      "description": "data of request.answer.updated, sent only to the person who answered, to all their devices (subject_id is the message id). Carries no comment text: has_comment tells whether to reload it. version is the version of the person's answer.",
      "type": "object",
      "additionalProperties": false,
      "required": ["message_id", "chat_id", "option", "has_comment", "late", "version"],
      "properties": {
        "message_id": { "$ref": "#/$defs/UUID" },
        "chat_id": { "$ref": "#/$defs/UUID" },
        "option": { "type": "integer", "minimum": 0, "maximum": 3 },
        "has_comment": { "type": "boolean" },
        "late": { "type": "boolean" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "RequestRemindedEvent": {
      "description": "data of request.reminded, sent to each recipient who has not answered (subject_id is the message id): a manual reminder by the author or the automatic one. Triggers a push.",
      "type": "object",
      "additionalProperties": false,
      "required": ["message_id", "chat_id", "kind"],
      "properties": {
        "message_id": { "$ref": "#/$defs/UUID" },
        "chat_id": { "$ref": "#/$defs/UUID" },
        "kind": { "type": "string", "enum": ["manual", "auto"] }
      }
    },
    "RequestAutoRemindedEvent": {
      "description": "data of request.auto_reminded, sent only to the author (subject_id is the message id): the outcome of the automatic reminder, also when everyone has answered (reminded is 0). Triggers a push.",
      "type": "object",
      "additionalProperties": false,
      "required": ["message_id", "chat_id", "reminded", "answered_count", "waiting_count"],
      "properties": {
        "message_id": { "$ref": "#/$defs/UUID" },
        "chat_id": { "$ref": "#/$defs/UUID" },
        "reminded": { "type": "integer", "minimum": 0 },
        "answered_count": { "type": "integer", "minimum": 0 },
        "waiting_count": { "type": "integer", "minimum": 0 }
      }
    },
    "ReminderEvent": {
      "description": "data of reminder.created, reminder.updated and reminder.deleted, sent only to the owner's devices (subject_id is the reminder id). Never carries the note or the message text. reason is present on reminder.deleted only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "message_id", "chat_id", "remind_at", "state", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/UUID" },
        "message_id": { "$ref": "#/$defs/NullableUUID" },
        "chat_id": { "$ref": "#/$defs/UUID" },
        "remind_at": { "type": "string", "format": "date-time" },
        "state": { "type": "string", "enum": ["pending", "fired"] },
        "version": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string", "enum": ["removed", "message_deleted"] }
      }
    },
    "ReminderFiredEvent": {
      "description": "data of reminder.fired, sent only to the owner's devices (subject_id is the reminder id). late: fired more than 15 minutes after remind_at. Triggers a push unless it is more than 6 hours late.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "message_id", "chat_id", "fired_at", "late", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/UUID" },
        "message_id": { "$ref": "#/$defs/NullableUUID" },
        "chat_id": { "$ref": "#/$defs/UUID" },
        "fired_at": { "type": "string", "format": "date-time" },
        "late": { "type": "boolean" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "OrgUpdatedEvent": {
      "description": "data of org.updated, sent to the whole workspace (chat_id null, subject_id is the organization id) once per transaction that changed the org structure, including deactivating or reactivating a person who had a membership, a position or led a department. Carries no content: the client reloads GET /api/v1/org with If-None-Match (after about 500 ms, to merge bursts) and drops the event when version is not greater than the cached one.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "reason"],
      "properties": {
        "version": { "type": "integer", "format": "int64", "minimum": 1 },
        "reason": {
          "type": "string",
          "enum": ["department", "position", "membership", "person_status"]
        }
      }
    },
    "TaskUpdatedEvent": {
      "description": "data of task.updated, sent to the whole chat (subject_id is the message id) on every change of a task except its title and description, which come as message.updated: status, due date, responsible person, items, taking, nudges, the overdue mark. task is MessageTask of openapi.yaml (the TaskUpdatedEvent schema there describes it in full); it is the same for every member, so the frame is shared. Clients replace the cached task when task.version is greater.",
      "type": "object",
      "additionalProperties": false,
      "required": ["message_id", "chat_id", "task"],
      "properties": {
        "message_id": { "$ref": "#/$defs/UUID" },
        "chat_id": { "$ref": "#/$defs/UUID" },
        "task": {
          "type": "object",
          "required": ["status", "version"],
          "properties": { "version": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "TaskNotifiedEvent": {
      "description": "data of task.notified, sent to one person only (audience_actor_id; subject_id is the message id): the reason for a push or a toast about a task. Never carries the title, the description or item texts. kinds: assigned — the new responsible person (creation, change); unassigned — the former responsible person, no push, removes the task from «Ждут вас» on every device; item_assigned — the assignee of an item; offered — each candidate of a new queue; taken — the author, a candidate took the task; nudged — the responsible person or the candidates, «Напомнить»; due_soon — the same, one hour before due_at; overdue — the responsible person and the author; due_changed — the responsible person; completed — the author, done by someone else; reopened — the responsible person, done → open by someone else. Not written for the person who acted. On creation every task.notified is written before message.created in the same transaction.",
      "type": "object",
      "additionalProperties": false,
      "required": ["message_id", "chat_id", "kind", "by_actor_id", "due_at"],
      "properties": {
        "message_id": { "$ref": "#/$defs/UUID" },
        "chat_id": { "$ref": "#/$defs/UUID" },
        "kind": {
          "type": "string",
          "enum": ["assigned", "unassigned", "item_assigned", "offered", "taken", "nudged", "due_soon", "overdue", "due_changed", "completed", "reopened"]
        },
        "by_actor_id": {
          "$ref": "#/$defs/NullableUUID",
          "description": "Who acted; null for due_soon and overdue, which the server sends by itself."
        },
        "due_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "ServerFrame": {
      "oneOf": [
        { "$ref": "#/$defs/HelloFrame" },
        { "$ref": "#/$defs/DurableEventFrame" },
        { "$ref": "#/$defs/ResyncRequiredFrame" },
        { "$ref": "#/$defs/TypingEventFrame" },
        { "$ref": "#/$defs/PresenceEventFrame" },
        { "$ref": "#/$defs/PresenceSnapshotFrame" },
        { "$ref": "#/$defs/AgentStatusEventFrame" },
        { "$ref": "#/$defs/MessageStreamingEventFrame" },
        { "$ref": "#/$defs/ProtocolErrorFrame" }
      ]
    }
  }
}
